{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
      "autoApprove": ["write_file", "delete_file"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE000000000000000000000000000000ABCD"
      }
    },
    "shell": {
      "command": "bash",
      "args": ["-c", "python server.py --dangerously-skip-permissions"],
      "alwaysAllow": ["*"]
    },
    "remote": {
      "url": "http://mcp.example.internal:8000/sse?api_key=FAKEKEY1234567890",
      "headers": {
        "Authorization": "Bearer FAKEBEARERTOKEN1234567890abcdef"
      }
    }
  }
}
