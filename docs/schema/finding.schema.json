{
  "$defs": {
    "Category": {
      "description": "High-level finding categories used for grouping and profiles.",
      "enum": [
        "code",
        "secrets",
        "dependencies",
        "configuration",
        "llm",
        "agents",
        "rag",
        "mcp"
      ],
      "title": "Category",
      "type": "string"
    },
    "Confidence": {
      "description": "How confident the analyzer is that the finding is a true positive.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A single piece of evidence supporting a finding.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "description": "Evidence kind, e.g. 'source', 'sink', 'line', 'config_key'.",
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Redacted code or config excerpt.",
          "title": "Snippet"
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingStatus": {
      "description": "Lifecycle status relative to a baseline and suppressions.",
      "enum": [
        "new",
        "existing",
        "suppressed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Source location. Lines and columns are 1-based; ``end_*`` are inclusive.",
      "properties": {
        "end_column": {
          "default": 1,
          "minimum": 1,
          "title": "End Column",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "description": "Path relative to the scan root, POSIX separators.",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "default": 1,
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file_path",
        "start_line",
        "end_line"
      ],
      "title": "Location",
      "type": "object"
    },
    "Severity": {
      "description": "Documented severity taxonomy, ordered from most to least severe.",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SuppressionInfo": {
      "additionalProperties": false,
      "description": "Why and by which mechanism a finding was suppressed.",
      "properties": {
        "expired": {
          "default": false,
          "title": "Expired",
          "type": "boolean"
        },
        "expires": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires"
        },
        "matched_by": {
          "description": "What matched: 'fingerprint', 'rule_id+path', or 'inline'.",
          "title": "Matched By",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "description": "'inline' or 'config'.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "reason",
        "matched_by"
      ],
      "title": "SuppressionInfo",
      "type": "object"
    }
  },
  "$id": "https://aegisai.dev/schema/finding-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized security finding.",
  "properties": {
    "analyzer": {
      "description": "Analyzer that produced the finding (e.g. 'python_ast').",
      "title": "Analyzer",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "cwe_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cwe Ids",
      "type": "array"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_summary": {
      "description": "One-line, redacted description of the evidence.",
      "title": "Evidence Summary",
      "type": "string"
    },
    "finding_id": {
      "description": "Unique id within a scan result.",
      "title": "Finding Id",
      "type": "string"
    },
    "fingerprint": {
      "description": "Stable identity across scans.",
      "minLength": 16,
      "title": "Fingerprint",
      "type": "string"
    },
    "first_seen": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set from the baseline when the finding already existed.",
      "title": "First Seen"
    },
    "impact": {
      "title": "Impact",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "owasp_references": {
      "items": {
        "type": "string"
      },
      "title": "Owasp References",
      "type": "array"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "remediation": {
      "title": "Remediation",
      "type": "string"
    },
    "review_required": {
      "default": false,
      "description": "True for heuristic findings that need human confirmation.",
      "title": "Review Required",
      "type": "boolean"
    },
    "rule_id": {
      "pattern": "^[A-Z]{3,4}[0-9]{3}$",
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "title": "Rule Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "new"
    },
    "suppression": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuppressionInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "rule_id",
    "rule_version",
    "title",
    "description",
    "category",
    "severity",
    "confidence",
    "location",
    "evidence_summary",
    "impact",
    "remediation",
    "analyzer",
    "fingerprint"
  ],
  "title": "AegisAI finding",
  "type": "object"
}
